import turtle
import math
import random

screen = turtle.Screen()
screen.bgcolor("black")
screen.title("Fast Colorful Heart")

t = turtle.Turtle()
t.hideturtle()
t.pensize(1)
t.speed(0)

colors = [
    "#ff0055",
    "#ff00ff",
    "#7a00ff",
    "#00e5ff",
    "#00ff88",
    "#ffe600",
    "#ff6600",
    "#ffffff"
]

# Turn off animation for maximum speed
screen.tracer(0)

for i in range(120):
    t.penup()
    t.goto(0, 0)

    angle = i * (math.pi * 2) / 120

    x = 16 * (math.sin(angle) ** 3) * 12
    y = (
        13 * math.cos(angle)
        - 5 * math.cos(2 * angle)
        - 2 * math.cos(3 * angle)
        - math.cos(4 * angle)
    ) * 12

    t.color(random.choice(colors))
    t.pendown()
    t.goto(x, y)

    for _ in range(8):
        t.forward(6)
        t.backward(6)
        t.right(45)

    screen.update()

turtle.done()